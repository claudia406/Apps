# Supabase プロジェクトの Settings > API から取得してください。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Settings > API > service_role キー。サーバー側(Route Handler)でのみ使用する。
# 絶対にブラウザに公開しない。NEXT_PUBLIC_ を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# アプリ全体を保護する HTTP Basic 認証の認証情報（本人のみが知る値を設定してください）。
# ブラウザのネイティブな認証ダイアログが表示され、アプリ内にログイン画面は作らない。
BASIC_AUTH_USER=shiori
BASIC_AUTH_PASSWORD=xxxxxxxxxxxxxxxxxxxxxx
